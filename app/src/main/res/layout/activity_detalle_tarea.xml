<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingHorizontal="24dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="80dp">

        <!-- Título principal -->
        <TextView
            android:id="@+id/tvTituloDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título de la tarea"
            android:textColor="@color/purple_500"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="28dp"
            android:letterSpacing="0.02" />

        <!-- Card de contenido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_detalle"
            android:padding="28dp"
            android:elevation="8dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="36dp"
            android:clipToOutline="true"
            android:gravity="center_vertical"
            android:layout_gravity="center">

            <!-- Descripción -->
            <TextView
                android:id="@+id/tvDescripcionDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción de la tarea"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Fecha y hora -->
            <TextView
                android:id="@+id/tvFechaHoraDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha y hora"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:alpha="0.9"
                android:gravity="end" />

        </LinearLayout>

        <!-- Botón volver -->
        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al panel"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:backgroundTint="@color/purple_500"
            android:textColor="@color/white"
            android:elevation="6dp"
            android:layout_marginTop="8dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="32dp"
            android:layout_gravity="center"
            android:drawableStart="@android:drawable/ic_media_previous"
            android:drawablePadding="8dp" />
        <!-- Botón editar -->
        <Button
            android:id="@+id/btnEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar tarea"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:backgroundTint="@color/purple_500"
            android:textColor="@color/white"
            android:elevation="6dp"
            android:layout_marginTop="8dp"
            android:paddingVertical="10dp"
            android:drawableStart="@android:drawable/ic_menu_edit"
            android:drawablePadding="8dp" />

    </LinearLayout>
</ScrollView>

