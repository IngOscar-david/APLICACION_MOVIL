<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.RemindmeV2" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores base del tema -->
        <item name="colorPrimary">@color/purple_500</item><!-- estaba white-->
        <item name="colorOnPrimary">@color/white</item><!-- estaba black-->
        <item name="colorPrimaryContainer">@color/purple_500</item><!-- estaba white-->

        <!-- Fondo general de la app -->
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.RemindmeV2" parent="Base.Theme.RemindmeV2" />

    <style name="Theme.RemindmeV2.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.RemindmeV2.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- <style name="Theme.RemindmeV2.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />-->

    <!-- <style name="Theme.RemindmeV2.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />-->

     <style name="Theme.RemindmeV2.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar">
         <item name="colorPrimary">@color/purple_500</item>
         <item name="colorOnPrimary">@color/white</item>
     </style>

     <style name="Theme.RemindmeV2.PopupOverlay" parent="ThemeOverlay.Material3.Light">
         <item name="colorPrimary">@color/purple_500</item>
         <item name="colorOnPrimary">@color/white</item>
         <item name="colorSurface">@color/white</item>
     </style>


 </resources>
